<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="mesh_path" value="package://p105_description/urdf/meshes" />
  
  <xacro:property name="mass_hip" value="0.318"/>
  <xacro:property name="mass_thigh" value="0.055"/>
  <xacro:property name="mass_calf" value="0.047"/>
  <xacro:property name="mass_foot" value="0.05"/>

  <xacro:macro name="leg" params="
      prefix
      hip_xyz hip_rpy
      thigh_xyz thigh_rpy
      calf_xyz calf_rpy
      hip_mesh
      thigh_mesh
      calf_mesh
      hip_visual_rpy
      thigh_visual_rpy
      calf_visual_rpy
      hip_inertial_xyz
      thigh_inertial_xyz
      calf_inertial_xyz">

    <joint name="${prefix}_hip_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_hip_link"/>
      <origin xyz="${hip_xyz}" rpy="${hip_rpy}"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1" upper="1" effort="3.43" velocity="7.48"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="${prefix}_hip_link">
      <visual>
        <geometry>
          <mesh filename="${hip_mesh}" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${hip_visual_rpy}"/>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${hip_mesh}" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${hip_visual_rpy}"/>
      </collision>
      <inertial>
        <mass value="${mass_hip}"/>
        <origin xyz="${hip_inertial_xyz}" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="0" ixz="0" iyy="0.0" iyz="0" izz="0.0"/>
      </inertial>
    </link>

    <joint name="${prefix}_thigh_joint" type="revolute">
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_thigh_link"/>
      <origin xyz="${thigh_xyz}" rpy="${thigh_rpy}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14" upper="3.14" effort="3.43" velocity="7.48"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="${prefix}_thigh_link">
      <visual>
        <geometry>
          <mesh filename="${thigh_mesh}" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${thigh_visual_rpy}"/>
        <material name="white"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${thigh_mesh}" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${thigh_visual_rpy}"/>
      </collision>
      <inertial>
        <mass value="${mass_thigh}"/>
        <origin xyz="${thigh_inertial_xyz}" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="0" ixz="0" iyy="0.0" iyz="0" izz="0.0"/>
      </inertial>
    </link>

    <joint name="${prefix}_calf_joint" type="revolute">
      <parent link="${prefix}_thigh_link"/>
      <child link="${prefix}_calf_link"/>
      <origin xyz="${calf_xyz}" rpy="${calf_rpy}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14" upper="0" effort="3.43" velocity="7.48"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>

    <link name="${prefix}_calf_link">
      <visual>
        <geometry>
          <mesh filename="${calf_mesh}" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${calf_visual_rpy}"/>
        <material name="grey"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${calf_mesh}" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${calf_visual_rpy}"/>
      </collision>
      <inertial>
        <mass value="${mass_calf}"/>
        <origin xyz="${calf_inertial_xyz}" rpy="0 0 0"/>
        <inertia ixx="0.0" ixy="0" ixz="0" iyy="0.0" iyz="0" izz="0.0"/>
      </inertial>
    </link>

    <joint name="${prefix}_foot_fixed" type="fixed">
      <parent link="${prefix}_calf_link"/>
      <child link="${prefix}_foot"/>
      <origin xyz="0.003 0 -0.102" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_foot">
      <visual>
        <geometry><sphere radius="0.013"/></geometry>
        <material name="red"/>
      </visual>
      <collision>
        <geometry><sphere radius="0.015"/></geometry>
      </collision>
      <inertial>
        <mass value="${mass_foot}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

  </xacro:macro>

  <xacro:macro name="p105_urdf">

    <material name="blue"><color rgba="0 0.2 0.3 1"/></material>
    <material name="white"><color rgba="1 1 1 1"/></material>
    <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
    <material name="red"><color rgba="1 0 0 1"/></material>

    <link name="base_footprint" />
    <joint name="base_footprint_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="base_link">
      <visual>
        <geometry>
          <mesh filename="${mesh_path}/body.stl" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="${mesh_path}/body.stl" scale="1 1 1"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0.001 0.0 0.001" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0031"/>
      </inertial>
    </link>

    <xacro:leg
      prefix="FL"
      hip_xyz="0.074 0.0473 0.0115"
      hip_rpy="0 0 0"
      thigh_xyz="0.021 0.0255 -0.001"
      thigh_rpy="0 0 0"
      calf_xyz="0 0.014 -0.1"
      calf_rpy="0 0 0"
      hip_mesh="${mesh_path}/fl_hip.stl"
      thigh_mesh="${mesh_path}/fl_thigh.stl"
      calf_mesh="${mesh_path}/fl_calf.stl"
      hip_visual_rpy="0 0 3.14"
      thigh_visual_rpy="0 0 0"
      calf_visual_rpy="0 0 0"
      hip_inertial_xyz="-0.031 -0.01 -0.01"
      thigh_inertial_xyz="0.0 -0.014 -0.044"
      calf_inertial_xyz="0.001 0.0 -0.088"
    />

    <xacro:leg
      prefix="FR"
      hip_xyz="0.074 -0.0473 0.0115"
      hip_rpy="0 0 0"
      thigh_xyz="0.021 -0.0255 -0.001"
      thigh_rpy="0 0 0"
      calf_xyz="0 -0.014 -0.1"
      calf_rpy="0 0 0"
      hip_mesh="${mesh_path}/fr_hip.stl"
      thigh_mesh="${mesh_path}/fr_thigh.stl"
      calf_mesh="${mesh_path}/fl_calf.stl"
      hip_visual_rpy="0 0 0"
      thigh_visual_rpy="0 0 0"
      calf_visual_rpy="0 0 0"
      hip_inertial_xyz="-0.031 0.01 -0.01"
      thigh_inertial_xyz="0.0 0.014 -0.044"
      calf_inertial_xyz="0.001 0.0 -0.088"
    />

    <xacro:leg
      prefix="RL"
      hip_xyz="-0.074 0.0473 0.0115"
      hip_rpy="0 0 0"
      thigh_xyz="-0.041 0.0255 -0.001"
      thigh_rpy="0 0 0"
      calf_xyz="0 0.014 -0.1"
      calf_rpy="0 0 0"
      hip_mesh="${mesh_path}/rl_hip.stl"
      thigh_mesh="${mesh_path}/fl_thigh.stl"
      calf_mesh="${mesh_path}/fl_calf.stl"
      hip_visual_rpy="0 0 3.14"
      thigh_visual_rpy="0 0 0"
      calf_visual_rpy="0 0 0"
      hip_inertial_xyz="-0.031 -0.01 -0.01"
      thigh_inertial_xyz="0.0 -0.014 -0.044"
      calf_inertial_xyz="0.001 0.0 -0.088"
    />

    <xacro:leg
      prefix="RR"
      hip_xyz="-0.074 -0.0473 0.0115"
      hip_rpy="0 0 0"
      thigh_xyz="-0.041 -0.0255 -0.001"
      thigh_rpy="0 0 0"
      calf_xyz="0 -0.014 -0.1"
      calf_rpy="0 0 0"
      hip_mesh="${mesh_path}/rr_hip.stl"
      thigh_mesh="${mesh_path}/fr_thigh.stl"
      calf_mesh="${mesh_path}/fl_calf.stl"
      hip_visual_rpy="0 0 0"
      thigh_visual_rpy="0 0 0"
      calf_visual_rpy="0 0 0"
      hip_inertial_xyz="-0.031 0.01 -0.01"
      thigh_inertial_xyz="0.0 0.014 -0.044"
      calf_inertial_xyz="0.001 0.0 -0.088"
    />

  </xacro:macro>

</robot>